{
  "name": "novichek/web",
  "type": "project",
  "description": "ООО Новичёк — корпоративный сайт, CRM и realtime-чат на Laravel + Vue",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/reverb": "^1.5",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^2.10",
    "pusher/pusher-php-server": "^7.2",
    "irazasyed/telegram-bot-sdk": "^3.15"
  },
  "require-dev": {
    "laravel/breeze": "^2.3",
    "fakerphp/faker": "^1.23",
    "nunomaduro/pint": "^1.18",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\": "app/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r "file_exists('.env') || copy('.env.example', '.env');""
    ],
    "dev": [
      "php artisan serve",
      "php artisan queue:listen --tries=1",
      "php artisan reverb:start --host=0.0.0.0 --port=8080",
      "npm run dev"
    ]
  }
}
