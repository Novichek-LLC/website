{
    "name": "dreamcms/modern",
    "type": "project",
    "description": "Modernized DreamCMS based on the original archive, upgraded to Laravel 12 with a compatibility-first frontend build.",
    "keywords": [
        "laravel",
        "vue",
        "minecraft",
        "cms"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "algolia/algoliasearch-client-php": "^2.7",
        "ashallendesign/laravel-exchange-rates": "^7.0",
        "backpack/crud": "^6.8",
        "backpack/logmanager": "^4.0",
        "backpack/pagemanager": "^3.0",
        "backpack/permissionmanager": "^7.0",
        "backpack/settings": "^3.0",
        "baril/sqlout": "^1.0",
        "barryvdh/laravel-elfinder": "^0.5.1",
        "cviebrock/eloquent-sluggable": "^12.0",
        "cybercog/laravel-ban": "^6.0",
        "d3lph1/minecraft-rcon-manager": "^1.3",
        "doctrine/dbal": "^4.0",
        "genert/bbcode": "^1.1",
        "geoip2/geoip2": "^2.13",
        "google/recaptcha": "^1.3",
        "irazasyed/telegram-bot-sdk": "^3.15",
        "intervention/image": "^3.11",
        "intervention/image-laravel": "^1.5",
        "laravel/framework": "^12.0",
        "laravel/scout": "^10.18",
        "laravel/socialite": "^5.16",
        "laravel/tinker": "^2.10",
        "league/flysystem-aws-s3-v3": "^3.0",
        "mews/captcha": "^3.4",
        "mews/purifier": "^3.4",
        "owen-it/laravel-auditing": "^14.0",
        "pragmarx/google2fa-laravel": "^2.3",
        "pragmarx/google2fa-qrcode": "^3.0",
        "predis/predis": "^2.4",
        "sentry/sentry-laravel": "^4.22",
        "socialiteproviders/discord": "^4.2",
        "socialiteproviders/google": "^4.1",
        "socialiteproviders/mailru": "^4.1",
        "socialiteproviders/manager": "^4.8",
        "socialiteproviders/steam": "^4.3",
        "socialiteproviders/telegram": "^4.1",
        "socialiteproviders/vkontakte": "^5.1",
        "socialiteproviders/yandex": "^4.1",
        "spatie/laravel-permission": "^6.0",
        "symfony/yaml": "^7.0",
        "torann/geoip": "^3.0",
        "tymon/jwt-auth": "^2.3",
        "vearutop/php-obscene-censor-rus": "^1.0",
        "yadahan/laravel-authentication-log": "^1.9"
    },
    "require-dev": {
        "backpack/generators": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.0",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "orangehill/iseed": "^3.8",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeders",
            "database/factories"
        ],
        "files": [
            "app/Helpers/Color.php",
            "app/Helpers/Date.php",
            "app/Censure.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
